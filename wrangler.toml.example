# 复制为 wrangler.toml，填入自己的 D1 database_id 后使用。
# 需要先创建 D1、先完成 worker/index.js（见 docs/cloudflare-workers-migration.md）。

name = "mai-song-quiz"
main = "worker/index.js"
compatibility_date = "2025-09-01"
workers_dev = true

# 由 npm run build:cf 生成：index.html + assets/
[assets]
directory = "./public"
binding = "ASSETS"
# 所有请求先进入 Worker，再由 Worker 决定 API / WebSocket / 静态资源
run_worker_first = true

[[d1_databases]]
binding = "DB"
database_name = "mai-quiz"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

# 单实例 RoomHub：先保持和现有 Node 内存房间一致。
# 以后要做每房一个 DO，可从这里拆成 RoomDO，并配合注册表。
[[durable_objects.bindings]]
name = "ROOMS"
class_name = "RoomHub"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["RoomHub"]

[observability]
enabled = true
